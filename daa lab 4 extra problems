        "import heapq\n",
        "\n",
        "def dijkstra(graph, start, end):\n",
        "    queue = [(0, start, [start])]\n",
        "    visited = set()\n",
        "\n",
        "    while queue:\n",
        "        (cost, node, path) = heapq.heappop(queue)\n",
        "\n",
        "        if node == end:\n",
        "            return cost, path\n",
        "\n",
        "        if node not in visited:\n",
        "            visited.add(node)\n",
        "            for next_node, weight in graph[node].get('neighbors', []):\n",
        "                if next_node not in visited:\n",
        "                    heapq.heappush(queue, (cost + weight, next_node, path + [next_node]))\n",
        "\n",
        "    return float(\"inf\"), []\n",
        "\n",
        "# Graph representation\n",
        "city_network = {\n",
        "    0: {'neighbors': [(1, 4), (2, 2)]},\n",
        "    1: {'neighbors': [(3, 5)]},\n",
        "    2: {'neighbors': [(1, 1), (4, 10)]},\n",
        "    3: {'neighbors': [(4, 2)]},\n",
        "    4: {'neighbors': []}\n",
        "}\n",
        "\n",
        "total_time, fastest_route = dijkstra(city_network, 0, 4)\n",
        "print(f\"Fastest time: {total_time} mins\")\n",
        "print(f\"Route: {' -> '.join(map(str, fastest_route))}\")\n"
      ]
