        "import heapq\n",
        "\n",
        "def dijkstra_prefer_fewer_hops(graph, start, end):\n",
        "    # Min-heap format: (total_weight, hop_count, current_node, path)\n",
        "    queue = [(0, 0, start, [start])]\n",
        "\n",
        "    # Tracks the best observed tracking parameters: node -> (weight, hops)\n",
        "    best_states = {start: (0, 0)}\n",
        "\n",
        "    while queue:\n",
        "        weight, hops, node, path = heapq.heappop(queue)\n",
        "\n",
        "        # Target reached optimally due to priority queue ordering\n",
        "        if node == end:\n",
        "            return weight, hops, path\n",
        "\n",
        "        # Skip if we already found a strictly better state for this node\n",
        "        if (weight, hops) > best_states.get(node, (float('inf'), float('inf'))):\n",
        "            continue\n",
        "\n",
        "        for neighbor, edge_weight in graph.get(node, []):\n",
        "            next_weight = weight + edge_weight\n",
        "            next_hops = hops + 1\n",
        "            next_state = (next_weight, next_hops)\n",
        "\n",
        "            # Tie-breaker logic: True if lower weight, OR same weight with fewer hops\n",
        "            if next_state < best_states.get(neighbor, (float('inf'), float('inf'))):\n",
        "                best_states[neighbor] = next_state\n",
        "                heapq.heappush(queue, (next_weight, next_hops, neighbor, path + [neighbor]))\n",
        "\n",
        "    return float('inf'), float('inf'), []\n"
