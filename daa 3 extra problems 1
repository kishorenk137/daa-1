        "def kruskal_mst(edges, num_vertices):\n",
        "    # Sort edges by weight\n",
        "    edges.sort(key=lambda x: x[2])\n",
        "\n",
        "    # Initialize disjoint set\n",
        "    parent = {i: i for i in range(num_vertices)}\n",
        "\n",
        "    def find(i):\n",
        "        if parent[i] == i:\n",
        "            return i\n",
        "        return find(parent[i])\n",
        "\n",
        "    def union(i, j):\n",
        "        root_i = find(i)\n",
        "        root_j = find(j)\n",
        "        parent[root_i] = root_j\n",
        "\n",
        "    mst = []\n",
        "    total_cost = 0\n",
        "\n",
        "    # Map cities to array indices\n",
        "    city_map = {'A': 0, 'B': 1, 'C': 2, 'D': 3, 'E': 4, 'F': 5}\n",
        "\n",
        "    for u, v, weight in edges:\n",
        "        u_idx, v_idx = city_map[u], city_map[v]\n",
        "        if find(u_idx) != find(v_idx):\n",
        "            union(u_idx, v_idx)\n",
        "            mst.append(f\"{u}-{v} ({weight})\")\n",
        "            total_cost += weight\n",
        "\n",
        "    return mst, total_cost\n",
        "\n",
        "# Define network edges\n",
        "network_edges = [\n",
        "    ('A', 'B', 4), ('A', 'C', 2), ('B', 'C', 5), ('B', 'D', 10),\n",
        "    ('C', 'E', 3), ('D', 'E', 7), ('D', 'F', 8), ('E', 'F', 6)\n",
        "]\n",
        "\n",
        "mst_edges, min_cost = kruskal_mst(network_edges, 6)\n",
        "print(\"Edges in MST:\", mst_edges)\n",
        "print(\"Total connection cost:\", min_cost)\n"
      ]
    }
