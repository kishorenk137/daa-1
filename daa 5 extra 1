        "def min_max_second_dc(arr, low, high):\n",
        "    \"\"\"\n",
        "    Returns a tuple containing:\n",
        "    (min1, min2, max1, max2, comparison_count)\n",
        "    \"\"\"\n",
        "    # Base Case 1: A single element\n",
        "    if low == high:\n",
        "        # Second min/max are populated with infinity to signify empty boundary states\n",
        "        return arr[low], float('inf'), arr[low], float('-inf'), 0\n",
        "\n",
        "    # Base Case 2: Exactly two elements (Requires 1 comparison)\n",
        "    if high == low + 1:\n",
        "        if arr[low] < arr[high]:\n",
        "            return arr[low], arr[high], arr[high], arr[low], 1\n",
        "        return arr[high], arr[low], arr[low], arr[high], 1\n",
        "\n",
        "    # --- Divide Step ---\n",
        "    mid = (low + high) // 2\n",
        "    l_min1, l_min2, l_max1, l_max2, l_comps = min_max_second_dc(arr, low, mid)\n",
        "    r_min1, r_min2, r_max1, r_max2, r_comps = min_max_second_dc(arr, mid + 1, high)\n",
        "\n",
        "    total_comps = l_comps + r_comps\n",
        "\n",
        "    # --- Conquer Step: Combine Minimums (Requires 2 comparisons) ---\n",
        "    total_comps += 1\n",
        "    if l_min1 < r_min1:\n",
        "        min1 = l_min1\n",
        "        total_comps += 1\n",
        "        min2 = l_min2 if l_min2 < r_min1 else r_min1\n",
        "    else:\n",
        "        min1 = r_min1\n",
        "        total_comps += 1\n",
        "        min2 = l_min1 if l_min1 < r_min2 else r_min2\n",
        "\n",
        "    # --- Conquer Step: Combine Maximums (Requires 2 comparisons) ---\n",
        "    total_comps += 1\n",
        "    if l_max1 > r_max1:\n",
        "        max1 = l_max1\n",
        "        total_comps += 1\n",
        "        max2 = l_max2 if l_max2 > r_max1 else r_max1\n",
        "    else:\n",
        "        max1 = r_max1\n",
        "        total_comps += 1\n",
        "        max2 = l_max1 if l_max1 > r_max2 else r_max2\n",
        "\n",
        "    return min1, min2, max1, max2, total_comps\n",
        "\n",
        "# --- Execution Verification ---\n",
        "demo_arr = [3, 1, 7, 4, 9, 2, 8, 5, 6, 0]\n",
        "mn1, mn2, mx1, mx2, comps = min_max_second_dc(demo_arr, 0, len(demo_arr) - 1)\n",
        "\n",
        "print(f\"Array: {demo_arr}\")\n",
        "print(f\"Minimums: 1st={mn1}, 2nd={mn2}\")\n",
        "print(f\"Maximums: 1st={mx1}, 2nd={mx2}\")\n",
        "print(f\"Total Comparisons Used: {comps}\")\n"
      ]
    }
