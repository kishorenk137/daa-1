        "import sys\n",
        "\n",
        "def prim_adjacency_matrix(graph, V):\n",
        "    # Track vertices included in MST\n",
        "    selected = [False] * V\n",
        "    # Store minimum weight edge to connect vertex to MST\n",
        "    key = [sys.maxsize] * V\n",
        "    # Store the MST structure (parent of each vertex)\n",
        "    parent = [-1] * V\n",
        "\n",
        "    # Start with the first vertex\n",
        "    key[0] = 0\n",
        "    parent[0] = -1  # First node is the root\n",
        "\n",
        "    for _ in range(V):\n",
        "        # Find the minimum key vertex not yet included in MST\n",
        "        min_val = sys.maxsize\n",
        "        u = -1\n",
        "\n",
        "        for v in range(V):\n",
        "            if not selected[v] and key[v] < min_val:\n",
        "                min_val = key[v]\n",
        "                u = v\n",
        "\n",
        "        # Include the picked vertex in the MST\n",
        "        selected[u] = True\n",
        "\n",
        "        # Update key value and parent index of the adjacent vertices\n",
        "        for v in range(V):\n",
        "            # graph[u][v] is non-zero only for adjacent vertices\n",
        "            # Update only if graph[u][v] is smaller than key[v]\n",
        "            if graph[u][v] != 0 and not selected[v] and graph[u][v] < key[v]:\n",
        "                key[v] = graph[u][v]\n",
        "                parent[v] = u\n",
        "\n",
        "        # Print the constructed MST\n",
        "    print(\"Edge \\tWeight\")\n",
        "    for i in range(1, V):\n",
        "        print(f\"{parent[i]} - {i} \\t{graph[i][parent[i]]}\")\n",
        "\n",
        "# Example usage for a 100-vertex graph (randomized or dummy setup)\n",
        "if __name__ == \"__main__\":\n",
        "    V = 100\n",
        "    # Create a dense graph matrix initialized with weights\n",
        "    # For demonstration, we create a pseudo-random dense graph\n",
        "    import random\n",
        "    random.seed(42)\n",
        "\n",
        "    graph = [[0] * V for _ in range(V)]\n",
        "    for i in range(V):\n",
        "        for j in range(i + 1, V):\n",
        "            weight = random.randint(1, 50)\n",
        "            graph[i][j] = weight\n",
        "            graph[j][i] = weight\n",
        "\n",
        "    prim_adjacency_matrix(graph, V)\n"
      ]
