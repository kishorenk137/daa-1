        "import random\n",
        "\n",
        "def quickselect_iterative(arr, k_1_indexed):\n",
        "    \"\"\"\n",
        "    Finds the k-th smallest element in an unsorted list iteratively.\n",
        "    Uses O(1) auxiliary space and protects against stack overflow.\n",
        "    \"\"\"\n",
        "    if not 1 <= k_1_indexed <= len(arr):\n",
        "        raise ValueError(\"k value is out of array bounds.\")\n",
        "\n",
        "    # Work on a copy to keep the original array unchanged\n",
        "    working_arr = arr.copy()\n",
        "\n",
        "    # Convert 1-based k value to 0-based target index\n",
        "    target_idx = k_1_indexed - 1\n",
        "    left, right = 0, len(working_arr) - 1\n",
        "\n",
        "    while left <= right:\n",
        "        if left == right:\n",
        "            return working_arr[left]\n",
        "\n",
        "        # Choose a random pivot index and partition the current range\n",
        "        pivot_idx = random.randint(left, right)\n",
        "        pivot_idx = partition(working_arr, left, right, pivot_idx)\n",
        "\n",
        "        # Binary-search-like decision boundary\n",
        "        if pivot_idx == target_idx:\n",
        "            return working_arr[pivot_idx]\n",
        "        elif pivot_idx > target_idx:\n",
        "            right = pivot_idx - 1  # Narrow search window to the left partition\n",
        "        else:\n",
        "            left = pivot_idx + 1   # Narrow search window to the right partition\n",
        "\n",
        "    return working_arr[left]\n",
        "\n",
        "def partition(arr, left, right, pivot_index):\n",
        "    pivot_value = arr[pivot_index]\n",
        "    # Swap pivot out of the way to the right end safely\n",
        "    arr[pivot_index], arr[right] = arr[right], arr[pivot_index]\n",
        "\n",
        "    store_index = left\n",
        "    for i in range(left, right):\n",
        "        if arr[i] < pivot_value:\n",
        "            arr[i], arr[store_index] = arr[store_index], arr[i]\n",
        "            store_index += 1\n",
        "\n",
        "    # Place pivot back into its finalized, sorted position\n",
        "    arr[right], arr[store_index] = arr[store_index], arr[right]\n",
        "    return store_index\n",
        "\n"
      ]
